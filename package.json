{
  "name": "watchparty-aspnet",
  "version": "0.1.0",
  "description": "Sync any webpage's HTML5 video across viewers in realtime through an ASP.NET Core API on Cloudflare D1, a watch-party browser extension.",
  "license": "MIT",
  "author": "Okoli Ryan",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "watch": "vite build --watch",
    "build:firefox": "npm run build && node scripts/build-firefox.mjs",
    "preview": "vite preview",
    "zip": "npm run build && node scripts/zip.mjs chrome",
    "zip:firefox": "npm run build:firefox && node scripts/zip.mjs firefox",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "tsc --noEmit && vite build --config web/vite.config.ts",
    "web:preview": "vite preview --config web/vite.config.ts",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@medv/finder": "^4.0.2",
    "@microsoft/signalr": "9.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.28",
    "@types/chrome": "^0.0.287",
    "@types/node": "22.15.30",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "3.2.4"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
