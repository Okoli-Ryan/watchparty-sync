# Copy this file to `.env` and point the extension and web dashboard at the API.
# The URL is not a secret: every request is authorised by the token the API issues
# at sign-in, and the server checks permissions on every write.
#
# Local development: `dotnet run --project server/src/WatchParty.Api` listens here.
VITE_API_URL=http://localhost:5080

# Firefox add-on id, used by `npm run build:firefox`. Must be one you control:
# `name@a-domain-you-own` or a UUID in braces. Optional for about:debugging,
# required before submitting to addons.mozilla.org.
WP_GECKO_ID=
