# Copy to .env next to docker-compose.yml (on the VPS: ~/watchparty/.env). Never commit it.

# Database password. Pick something long: openssl rand -hex 24
POSTGRES_PASSWORD=

# Signs login tokens. 32+ characters: openssl rand -base64 48
# Changing it signs everyone out.
JWT_SIGNING_KEY=

# Origins allowed to call the API from a browser.
# The extension:        chrome-extension://<extension id>
# The web dashboard:    https://your-dashboard.example.com   (optional; defaults to CORS_ORIGIN_0)
CORS_ORIGIN_0=
CORS_ORIGIN_1=

# Host port on 127.0.0.1 that your reverse proxy forwards to.
WATCHPARTY_PORT=8081
